# Переменные окружения для Pulsera App

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# WordPress Media Library
EXPO_PUBLIC_WP_URL=https://pulsera.ru
EXPO_PUBLIC_WP_USER=твой_логин_админки
EXPO_PUBLIC_WP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx-xxxx-xxxx

# Аналитика (опционально)
#EXPO_PUBLIC_ANALYTICS_ID=your_analytics_id_here
EXPO_PUBLIC_APP_ENV=development